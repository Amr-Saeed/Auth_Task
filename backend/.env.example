NODE_ENV=development
PORT=3000
MONGODB_URI=mongodb://localhost:27017/auth_app
# Required, 32+ characters. Generate one with: openssl rand -base64 48
JWT_SECRET=
JWT_EXPIRES_IN_SECONDS=3600
# Only needed if the frontend is served from a different origin than the API.
CORS_ORIGINS=
# Defaults to true in production (HTTPS only). Set false to test over plain HTTP.
COOKIE_SECURE=
# Set true behind nginx / a load balancer so rate limiting sees real client IPs.
TRUST_PROXY=false
LOG_LEVEL=
